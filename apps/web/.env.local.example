# MELE frontend local environment example
# Copy this file to apps/web/.env.local for local testing.
# Do not commit apps/web/.env.local.

# Supabase public values.
# You can find these in Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Python FastAPI calculation service.
# Local development usually uses http://127.0.0.1:8015.
# Production must be a real deployed API URL, not Vercel serverless.
MELE_API_URL=http://127.0.0.1:8015

# Web URL used by OAuth redirects, PWA metadata, payment return pages, and links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# LINE LIFF app id. Leave blank until LINE login is ready.
NEXT_PUBLIC_LIFF_ID=

# Social login switches.
# Google is enabled only after Supabase Auth Providers reports Google as active.
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=false
# LINE uses a Supabase custom OAuth provider by default.
NEXT_PUBLIC_ENABLE_LINE_LOGIN=false
NEXT_PUBLIC_LINE_OAUTH_PROVIDER=custom:line

# Turn on while you want bookings to skip ECPay and become confirmed directly.
NEXT_PUBLIC_ENABLE_FREE_BOOKING_TEST_MODE=false

# Sentry error tracking DSN (public, safe to expose in NEXT_PUBLIC_*).
# Get this from Sentry project settings -> Client Keys -> DSN.
NEXT_PUBLIC_SENTRY_DSN=

# Important:
# Supabase service_role, ECPay hash keys, and LINE channel token are server secrets.
# Put them in Supabase Edge Function secrets or the API host, never in NEXT_PUBLIC_*.
